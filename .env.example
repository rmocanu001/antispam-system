# Anti-Spam System Environment Configuration

# LLM Settings (Ollama)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:7b
LLM_TIMEOUT_SEC=120

# SpamAssassin
SPAMASSASSIN_HOST=spamassassin
SPAMASSASSIN_PORT=783

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Directories
SAMPLE_DIR=/data/samples
CLEAN_DIR=/data/clean
SPAM_DIR=/data/spam
QUARANTINE_DIR=/data/quarantine

# Domain Blocklist (comma-separated)
MALICIOUS_DOMAINS=spam.com,spamsite.biz,badmailer.test

# Weighted Ensemble Scoring
WEIGHT_LLM=0.5
WEIGHT_SA=0.3
WEIGHT_AUTH=0.2

# Gray Zone (SA score range for LLM invocation)
GRAY_ZONE_LOW=3.0
GRAY_ZONE_HIGH=8.0

# Policy Service
POLICY_LISTEN=0.0.0.0:9998

# SPF/DKIM (used for direct checks, bypassed when MTA handles them)
SOURCE_IP=203.0.113.1
HELO_DOMAIN=example.com

# Account Admin API credentials (change before production use)
ADMIN_USER=admin
ADMIN_PASS=changeme
